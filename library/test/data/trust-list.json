      "comment": "trust-list.xml (sequence number 2): accepted",
      "method": "ADD_TRUST_LIST",
      "parameters": {
        "bytes": ""
      }
    },
    {
      "comment": "the CA of the list: trusted, with its service",
      "method": "CERT_INFO",
      "parameters": {
        "bytes": ""
      }
    },
    {
      "comment": "the signer of lists: trustListSigner, not trusted",
      "method": "CERT_INFO",
      "parameters": {
        "bytes": ""
      }
    },
    {
      "comment": "trust-list-withdrawn.xml (sequence number 3): the service of the CA is withdrawn",
      "method": "ADD_TRUST_LIST",
      "parameters": {
        "bytes": ""
      }
    },
    {
